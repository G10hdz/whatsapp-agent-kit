# Copia a .env y llena. .env esta gitignoreado: el numero no se commitea.
# Numero DESECHABLE, solo digitos con lada, sin + ni espacios ni guiones.
# OJO Mexico: los celulares llevan 521 + 10 digitos en el JID de WhatsApp, no 52.
# Verificalo en auth-grupo/creds.json, campo "me".id, tras vincular.
WA_PHONE=52155XXXXXXXXX

# Vacio => modo descubrimiento (lista los JIDs de los grupos y sale).
# Con valor => manda el "hola" una vez a ese grupo.
GRUPO_JID=

# Opcional: WA_PAIR_MODE=qr vincula por codigo QR en la terminal en vez de
# codigo de 8 caracteres. Mas confiable: no depende de que WA_PHONE calce.
